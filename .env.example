# =============================================================================
# Calendrier Sport — configuration (copier en .env : cp .env.example .env)
# Ne jamais versionner le fichier .env !
# =============================================================================

# --- Accès réseau -------------------------------------------------------------
# Port publié par le conteneur web sur le LXC
APP_PORT=8080
# Interface d'écoute :
#   0.0.0.0     toutes les interfaces (filtrer alors avec le pare-feu Proxmox)
#   127.0.0.1   uniquement en local, exposé via « tailscale serve » (recommandé)
#   100.x.y.z   IP Tailscale du LXC / 10.8.0.x IP WireGuard
BIND_ADDRESS=0.0.0.0

# --- Base de données ------------------------------------------------------------
POSTGRES_DB=calendrier
POSTGRES_USER=calendrier
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Authentification -----------------------------------------------------------
# Clé de signature des JWT, 32 caractères minimum. Générer avec : openssl rand -hex 32
JWT_SECRET=
# Durée de validité d'une session (format « 30d », « 12h »…)
JWT_EXPIRES_IN=30d
# Optionnel : si renseigné, ce code est demandé à l'inscription
INVITE_CODE=

# --- Divers --------------------------------------------------------------------
# Fuseau pour « aujourd'hui » et les classements 7/30 jours
TZ=Europe/Paris
